# Copy to .env.local and fill in. VITE_* values are bundled into the browser app;
# everything else is read only by the dev / preview server.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloudinary: audience uploads and Set Cue media only (not the DAW Studio).
# The preset must be Unsigned; set moderation on it (see docs/storage-architecture.md).
# Admin Google accounts (comma separated): they see every project and file in the hub
# Admin Google accounts (comma-separated): see every project, delete (to the trash) and restore.
# Also used by `npm run rules:build` to generate database.rules.json — rebuild and redeploy after changing it.
VITE_ADMIN_EMAILS=

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: Cloudinary Admin API (lists folders such as theatre/cues/Default, reads AI moderation results)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2: all DAW Studio audio and project files (server-side only, never VITE_)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: public base URL for published audio (e.g. a custom domain on a *separate* public R2
# bucket). Without it, published audio is served at <this server>/api/r2/pub/theatre/public/…
R2_PUBLIC_BASE_URL=

# DAW Studio TTS (Microsoft neural zh-TW voices). Optional: official Azure Speech key + region
# (e.g. eastasia). Without them the server uses the free Edge Read Aloud endpoint (unofficial).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: Edge client version for the fallback endpoint, if Microsoft starts rejecting the built-in one
EDGE_TTS_VERSION=

# Static hosting (GitHub Pages): origin of the Cloudflare Worker serving /api/r2 (see wrangler.toml),
# e.g. https://theatre-r2.<your-subdomain>.workers.dev — set it before `npm run deploy`.
VITE_API_BASE=
